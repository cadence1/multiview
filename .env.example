# Copy this file to .env and fill in what you have. Nothing here is required
# to run the app — YouTube works out of the box via page-scraping — but
# adding keys makes status checks more reliable, and is required for Twitch
# and Kick.

# Port the server (and, in Docker, the whole app) listens on.
PORT=8080

# Optional. Google Cloud Console -> APIs & Services -> Credentials -> API key,
# with the "YouTube Data API v3" enabled. Improves channel lookup reliability;
# live/upcoming detection itself never uses API quota.
YOUTUBE_API_KEY=

# Required for Twitch support. Free app at https://dev.twitch.tv/console/apps
# (any redirect URL works, e.g. http://localhost — it's not used).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Required for Kick support. Free app at https://kick.com/settings/developer
# — any redirect URL works (e.g. http://localhost — it's not used, only the
# client credentials flow is). Needs the "channel:read" and "user:read"
# scopes.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# How often (in seconds) the server re-checks live/upcoming status for every
# tracked creator. Separately, any creator already showing "upcoming" with a
# scheduled start within a few minutes (in either direction) gets rechecked
# every 60s regardless of this setting, so a stream that's about to start
# doesn't sit undetected for the whole interval.
POLL_INTERVAL_SECONDS=300

# Optional — enables near-instant YouTube live detection (including
# unscheduled/"guerrilla" streams) via YouTube's own PubSubHubbub push
# notifications, instead of waiting for the next scrape. Both required
# together, or push is simply disabled and polling alone is used as before.
# See README's "YouTube push notifications" section for full setup —
# summary: needs a publicly reachable HTTPS endpoint (e.g. a Cloudflare
# Tunnel exposing only this one path), CALLBACK_URL is that public URL
# pointed at /api/youtube-push, and SECRET is a random string you generate
# yourself (e.g. `openssl rand -hex 32`) that authenticates incoming
# notifications via HMAC — never share it or commit it.
YOUTUBE_PUSH_CALLBACK_URL=
YOUTUBE_PUSH_SECRET=
