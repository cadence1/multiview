# Copy this file to .env and fill in what you have. Nothing here is required
# to run the app — YouTube works out of the box via page-scraping, and Kick
# needs no credentials — but adding keys makes status checks more reliable.

# Port the server (and, in Docker, the whole app) listens on.
PORT=8080

# Optional. Google Cloud Console -> APIs & Services -> Credentials -> API key,
# with the "YouTube Data API v3" enabled. Improves channel lookup reliability;
# live/upcoming detection itself never uses API quota.
YOUTUBE_API_KEY=

# Required for Twitch support. Free app at https://dev.twitch.tv/console/apps
# (any redirect URL works, e.g. http://localhost — it's not used).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# How often (in seconds) the server re-checks live/upcoming status for every
# tracked creator.
POLL_INTERVAL_SECONDS=90
